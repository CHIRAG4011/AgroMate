# ============================================
# AgroMate Environment Configuration
# Copy to .env and fill in your values
# ============================================

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./agromate.db

# --- BLE ---
BLE_SCAN_TIMEOUT=10
BLE_RECONNECT_INTERVAL=5
BLE_MAX_ROBOTS=5
BLE_SERVICE_UUID=0000ag00-0000-1000-8000-00805f9b34fb

# --- AI Models ---
PLANT_MODEL_PATH=models/plant_classifier.onnx
DISEASE_MODEL_PATH=models/disease_classifier.onnx
PEST_MODEL_PATH=models/pest_detector.onnx
AI_CONFIDENCE_THRESHOLD=0.65

# --- Voice ---
VOSK_MODEL_PATH=models/vosk-model-small-en-us
TTS_VOICE_EN=en-US-AriaNeural
TTS_VOICE_HI=hi-IN-SwaraNeural
TTS_VOICE_GU=gu-IN-DhwaniNeural
TTS_SAMPLE_RATE=16000
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# --- External APIs ---
PLANT_ID_API_KEY=
PLANTNET_API_KEY=
OPENWEATHER_API_KEY=
TREFLE_API_KEY=

# --- Chatbot ---
OPENAI_API_KEY=
CHATBOT_MODEL=gpt-4o-mini
CHATBOT_MAX_TOKENS=1024

# --- Cloud Sync ---
CLOUD_PROVIDER=none
FIREBASE_CREDENTIALS_PATH=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/agromate.log

# --- Dataset Manager ---
DATASET_DIR=datasets
DATASET_AUTO_UPDATE=true
DATASET_UPDATE_INTERVAL_HOURS=168
KAGGLE_USERNAME=
KAGGLE_KEY=
