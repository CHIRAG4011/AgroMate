# ============================================
# AgroMate .gitignore
# Python + PlatformIO + Android + Data
# ============================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
*.whl
venv/
.venv/
env/
.env
*.log

# ---------- PlatformIO & C/C++ ----------
.pio/
.pioenvs/
.piolibdeps/
.clang_complete
.gcc-flags.json
*.obj

# ---------- Arduino ----------
*.elf
*.bin
*.hex
*.map

# ---------- Android ----------
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/*.iml
android/.idea/
android/captures/
android/.externalNativeBuild/
android/.cxx/
*.apk
*.aab
*.jks
*.keystore

# ---------- IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------- Data & Models ----------
datasets/
*.tflite
*.h5
*.pt
*.pth
*.pkl
*.joblib

# ---------- Media ----------
*.wav
*.mp3
*.ogg
*.mp4

# ---------- Secrets ----------
.env
.env.*
!.env.example
secrets/
*.pem
*.key

# ---------- Uploads & DB ----------
frontend/uploads/
*.db
backend/agromate.db

# ---------- Backup, Scratch & Root Dumps ----------
*.backup
*.final_ov7670_qvga
firmware/backup/
/scratch/
/scratch_*
/gc2145.c.obj
/gc2145_disasm.txt
/gc2145_dump.txt
/gc2145_official.c
/gc2145_regs.h
/gc2145_settings.h
